#!/bin/bash
# Mock CASMO5 launcher for tests (NOT CASMO5). Usage: cas5 [options] <input>
# Writes <basename>.out in the single-state format assumed by the CASMO model,
# with k-inf = 0.9 + 0.1 * enrichment read from the "FUE" card, and an empty
# <basename>.cax. MOCK_CASMO_FAIL=1 simulates a crash.
for a in "$@"; do case "$a" in -*) ;; *) INP="$a" ;; esac; done
[ -f "$INP" ] || { echo "mock cas5: no input" >&2; exit 3; }
[ "$MOCK_CASMO_FAIL" = "1" ] && { echo "mock cas5: simulated failure" >&2; exit 4; }
B="${INP%.*}"
ENR=$(awk '$1=="FUE" {split($3, a, "/"); print a[2]; exit}' "$INP")
LC_ALL=C awk -v e="${ENR:-3}" 'BEGIN {
  print " MOCK CASMO5 OUTPUT (synthetic, for wrapper tests only)"
  printf "  2D k-infinity:   %.5f\n", 0.9 + 0.1 * e
}' > "$B.out"
: > "$B.cax"
